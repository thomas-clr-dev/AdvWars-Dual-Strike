<ui:UXML xmlns:xsi="[http://www.w3.org/2001/XMLSchema-instance](http://www.w3.org/2001/XMLSchema-instance)" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="PlayersHUD" style="flex-grow: 1; flex-direction: row; width: 100%; height: 100%;">

        <!-- ================= HUD JOUEUR 1 (Gauche) ================= -->
        <ui:VisualElement name="Player1HUD" style="flex-grow: 1; width: 50%; height: 100%; background-color: rgba(0,0,0,0);">

            <!-- BARRE DE STATS (Collée en haut) -->
            <ui:VisualElement name="StatsContainer" style="position: absolute; top: 0; width: 100%; height: 12%; background-color: rgb(45, 45, 45); flex-direction: row; justify-content: center; align-items: center;">
                <ui:Label text="Turn 1" name="Lbl_Turn" style="color: white; -unity-font-style: bold; font-size: 16px; margin-right: 20px;"/>
                <ui:Label text="Gold : 0" name="Lbl_Gold" style="color: white; -unity-font-style: bold; font-size: 16px;"/>
            </ui:VisualElement>

            <!-- BOUTON FIN TOUR (Collé en bas) -->
            <ui:Button text="FIN DU TOUR" name="Btn_EndTurn" style="position: absolute; bottom: 5%; align-self: center; width: 160px; height: 50px; background-color: rgb(141, 0, 0); color: white; -unity-font-style: bold; font-size: 16px; border-radius: 5px;"/>

            <!-- ÉCRAN NOIR (Couvre tout) -->
            <ui:VisualElement name="BlindOverlay" style="position: absolute; width: 100%; height: 100%; background-color: black; display: none; justify-content: center; align-items: center;">
                <ui:Label text="TURN PLAYER 2" style="color: grey; font-size: 30px; -unity-font-style: bold;"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ================= HUD JOUEUR 2 (Droite) ================= -->
        <ui:VisualElement name="Player2HUD" style="flex-grow: 1; width: 50%; height: 100%; background-color: rgba(0,0,0,0);">

            <!-- BARRE DE STATS -->
            <ui:VisualElement name="StatsContainer" style="position: absolute; top: 0; width: 100%; height: 12%; background-color: rgb(45, 45, 45); flex-direction: row; justify-content: center; align-items: center;">
                <ui:Label text="Turn 1" name="Lbl_Turn" style="color: white; -unity-font-style: bold; font-size: 16px; margin-right: 20px;"/>
                <ui:Label text="Gold : 0" name="Lbl_Gold" style="color: white; -unity-font-style: bold; font-size: 16px;"/>
            </ui:VisualElement>

            <!-- BOUTON FIN TOUR -->
            <ui:Button text="FIN DU TOUR" name="Btn_EndTurn" style="position: absolute; bottom: 5%; align-self: center; width: 160px; height: 50px; background-color: rgb(141, 0, 0); color: white; -unity-font-style: bold; font-size: 16px; border-radius: 5px;"/>

            <!-- ÉCRAN NOIR -->
            <ui:VisualElement name="BlindOverlay" style="position: absolute; width: 100%; height: 100%; background-color: black; display: flex; justify-content: center; align-items: center;">
                <ui:Label text="TURN PLAYER 1" style="color: grey; font-size: 30px; -unity-font-style: bold;"/>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>